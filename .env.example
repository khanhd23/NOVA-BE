# Copy this file to .env on the VPS and adjust the values for your environment.
# The systemd unit in deploy/systemd/nova-backend.service loads it automatically.

# Port exposed by the Java process. Nginx should proxy to this port.
SERVER_PORT=8080

# Quick smoke-test default. Replace with PostgreSQL when you are ready.
DATABASE_URL=jdbc:h2:file:/var/lib/nova-backend/nova-db;MODE=PostgreSQL;DATABASE_TO_UPPER=false;DB_CLOSE_DELAY=-1
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# PostgreSQL example:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/nova
# DATABASE_USERNAME=nova
# DATABASE_PASSWORD=change-me

# Writable directory for uploaded files.
NOVA_UPLOAD_DIR=/var/lib/nova-backend/uploads
NOVA_UPLOAD_MAX_FILE_SIZE=50MB
NOVA_UPLOAD_MAX_REQUEST_SIZE=60MB

# Social login and push/realtime toggles.
NOVA_GOOGLE_WEB_CLIENT_ID=655774214440-31qsc49ov49bemf24c1uoqunenebto31.apps.googleusercontent.com
NOVA_ALLOW_DEV_TOKENS=false
NOVA_FIREBASE_ENABLED=false
NOVA_FIREBASE_PROJECT_ID=
NOVA_FIREBASE_SERVICE_ACCOUNT_PATH=

# WebRTC defaults.
NOVA_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relay for calls on strict mobile/corporate networks (see deploy/coturn).
# deploy/coturn/setup-turn.sh prints the exact values to paste here.
NOVA_WEBRTC_TURN_SERVERS=
# Recommended: shared secret with coturn (use-auth-secret); the backend issues
# per-user credentials valid for NOVA_WEBRTC_TURN_TTL_SECONDS.
NOVA_WEBRTC_TURN_SECRET=
NOVA_WEBRTC_TURN_TTL_SECONDS=86400
# Alternative: one fixed username/password for everyone (ignored when TURN_SECRET is set).
NOVA_WEBRTC_TURN_USERNAME=
NOVA_WEBRTC_TURN_CREDENTIAL=
NOVA_WEBRTC_MAX_RESTART_ATTEMPTS=2
NOVA_WEBRTC_RESTART_BACKOFF_MS=1000

# Payment webhooks: shared secret used to verify the HMAC-SHA256 signature.
# Generate with: openssl rand -hex 32. Leave empty to reject all webhooks.
NOVA_PAYMENT_WEBHOOK_SECRET=
