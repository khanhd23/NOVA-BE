[Unit]
Description=NOVA backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/opt/NOVA-BE
EnvironmentFile=-/opt/NOVA-BE/.env
StateDirectory=nova-backend
ExecStart=/usr/bin/java -jar /opt/NOVA-BE/build/libs/nova-backend-0.1.0-SNAPSHOT.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
